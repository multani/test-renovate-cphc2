{
  "extends": ["config:recommended"],
  "prConcurrentLimit": 0,
  "customManagers": [
    //{
    //  "managerFilePatterns": ["*/install.sh"],
    //  "customType": "regex",
    //  "matchStrings": [
    //    "renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\sgit_tag=\"(?<currentValue>[^\"]+)\"",
    //  ],
    //  "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    //},

    {
      "customType": "regex",
      "managerFilePatterns": ["8.9*/install.sh"],
      "matchStrings": ["helm_chart_version=\"(?<currentValue>\\S+)\""],

      //"currentValueTemplate": "camunda-platform-8.9-{{{currentValue}}}",
      "extractVersionTemplate": "^camunda-platform-8.9-(?<version>\\S+)$",
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "camunda/camunda-platform-helm",
      //"versioningTemplate": "regex:^camunda-platform-8.9-(?<major>\\d+)(\\.(?<minor>\\d+))?(\\.(?<patch>\\d+))$",
    },

    {
      "customType": "regex",
      "managerFilePatterns": ["8.8*/install.sh"],
      "matchStrings": ["helm_chart_version=\"(?<currentValue>\\S+)\""],

      //"currentValueTemplate": "camunda-platform-8.8-{{{currentValue}}}",
      "extractVersionTemplate": "^camunda-platform-8.8-(?<version>\\S+)$",
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "camunda/camunda-platform-helm",
      //"versioningTemplate": "regex:^camunda-platform-8.8-(?<major>\\d+)(\\.(?<minor>\\d+))?(\\.(?<patch>\\d+))$",
    },

    {
      "customType": "regex",
      "managerFilePatterns": ["8.7*/install.sh"],
      "matchStrings": ["helm_chart_version=\"(?<currentValue>\\S+)\""],

      //"currentValueTemplate": "camunda-platform-8.7-{{{currentValue}}}",
      "extractVersionTemplate": "^camunda-platform-8.7-(?<version>\\S+)$",
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "camunda/camunda-platform-helm",
      //"versioningTemplate": "regex:^camunda-platform-8.7-(?<major>\\d+)(\\.(?<minor>\\d+))?(\\.(?<patch>\\d+))$",
    },

    {
      "customType": "regex",
      "managerFilePatterns": ["main/install.sh"],
      "matchStrings": ["helm_chart_version=\"(?<currentValue>\\S+)\""],

      //"currentValueTemplate": "camunda-platform-8.10-{{{currentValue}}}",
      "extractVersionTemplate": "^camunda-platform-8.10-(?<version>\\S+)$",
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "camunda/camunda-platform-helm",
      //"versioningTemplate": "regex:^camunda-platform-8.10-(?<major>\\d+)(\\.(?<minor>\\d+))?(\\.(?<patch>\\d+))(-alpha(?<prerelease>.*))?$",
    },
  ],

  "packageRules": [
    {
      "matchDepNames": ["camunda/camunda-platform-helm"],
      "matchDatasources": ["github-tags"],
      "ignoreUnstable": false,
    },
  ],
}

