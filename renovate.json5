{
  "extends": ["config:recommended"],
  "prConcurrentLimit": 0,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["*/install.sh"],
      "matchStrings": [
        "renovate: version=(?<parentVersion>.*?)\\s+helm_chart_version=\"(?<currentValue>[^\"]+)\"",
      ],
      "extractVersionTemplate": "^{{{parentVersion}}}-(?<version>\\S+)$",
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "camunda/camunda-platform-helm",
      "versioningTemplate": "regex:(?<major>\\d+)(\\.(?<minor>\\d+))?(\\.(?<patch>\\d+))(-alpha(?<prerelease>.*))?$",
    },

    {                                  
      "description": "Keep release load tests up-to-date",
      "customType": "regex",
      "managerFilePatterns": [
        "*/values.yaml",
      ],
      "matchStrings": [
        "registry: (?<registry>\\S+)\\s+repository: (?<depName>\\S+)\\s+tag: \"(?<currentValue>\\S+)\"",
      ],                                     
      "depNameTemplate": "camunda/camunda",  
      "datasourceTemplate": "github-releases",                                                                                                                                    
        //"allowedVersions": "<= 8.7"
    },

  ],

  "packageRules": [
    {
      "matchDepNames": ["camunda/camunda-platform-helm"],
      "matchDatasources": ["github-tags"],
      "commitMessageTopic": "camunda-platform Helm Chart",
    },
    {
      "matchDepNames": ["camunda/camunda-platform-helm"],
      "matchDatasources": ["github-tags"],
      "matchFileNames": ["main/*"],
      "ignoreUnstable": false,
    },
  ],
}

