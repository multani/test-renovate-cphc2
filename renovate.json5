    //  "managerFilePatterns": ["8.7*/install.sh"],
    //  "matchStrings": ["helm_chart_version=\"(?<currentValue>\\S+)\""],

    //  "extractVersionTemplate": "^camunda-platform-8.7-(?<version>\\S+)$",
    //  "datasourceTemplate": "github-tags",
    //  "depNameTemplate": "camunda/camunda-platform-helm",
    //},

    //{
    //  "customType": "regex",
    //  "managerFilePatterns": ["main/install.sh"],
    //  "matchStrings": ["helm_chart_version=\"(?<currentValue>\\S+)\""],

    //  "extractVersionTemplate": "^camunda-platform-8.10-(?<version>\\S+)$",
    //  "datasourceTemplate": "github-tags",
    //  "depNameTemplate": "camunda/camunda-platform-helm",
    //  "versioningTemplate": "regex:(?<major>\\d+)(\\.(?<minor>\\d+))?(\\.(?<patch>\\d+))(-alpha(?<prerelease>.*))?$",
    //},
  ],

  "packageRules": [
    {
      "matchDepNames": ["camunda/camunda-platform-helm"],
      "matchDatasources": ["github-tags"],

      "commitMessageTopic": "camunda-platform Helm Chart",
      //"groupName": "camunda-platform Helm Chart",
      //"groupSlug": "load-test-camunda-platform-chart",
    },
    {
      "matchDepNames": ["camunda/camunda-platform-helm"],
      "matchDatasources": ["github-tags"],
      // Allow alphas only on main
      "matchFileNames": ["main/*"],
      "ignoreUnstable": false,

      //"commitMessageTopic": "camunda-platform Helm Chart",
      //"groupName": "camunda-platform Helm Chart",
      //"groupSlug": "load-test-camunda-platform-chart",
    },
  ],
}

