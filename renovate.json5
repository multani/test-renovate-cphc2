{
  "extends": ["config:recommended"],
  "prConcurrentLimit": 0,
  "customManagers": [
    //{
    //  "managerFilePatterns": ["*/install.sh"],
    //  "customType": "regex",
    //  "matchStrings": [
    //    "renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\sgit_tag=\"(?<currentValue>[^\"]+)\"",
    //  ],
    //  "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    //},

    {
      "customType": "regex",
      "managerFilePatterns": ["*/install.sh"],
      "matchStrings": [
        //"renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?) version=(?<parentVersion>.*?)\\shelm_chart_version=\"(?<currentValue>[^\"]+)\"",
        "renovate: version=(?<parentVersion>.*?)\\s+helm_chart_version=\"(?<currentValue>[^\"]+)\"",
      ],

      "extractVersionTemplate": "^{{{parentVersion}}}-(?<version>\\S+)$",
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "camunda/camunda-platform-helm",
      "versioningTemplate": "regex:(?<major>\\d+)(\\.(?<minor>\\d+))?(\\.(?<patch>\\d+))(-alpha(?<prerelease>.*))?$",
    },

    //{
    //  "customType": "regex",
